# Copy to deploy/target.env and fill in. That file is gitignored.
#
#   cp deploy/target.env.example deploy/target.env

# ssh destination, user@host
SOAP_HOST=you@example.com

# Web root on the server. Must be writable by SOAP_HOST's user without sudo.
# SOAP_DIR=/var/www/soap.example.com

# Private key for that host.
# SOAP_KEY=$HOME/.ssh/simplesoap_deploy
